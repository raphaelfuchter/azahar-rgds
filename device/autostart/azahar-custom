#!/bin/sh
# Routes /usr/bin/azahar through bin/azahar-wrapper, which picks the optimized or the original build
# per game. Keeps a copy of the original as bin/real/azahar-stock (the bind mount hides it).
# Revert: delete this file and reboot.
B=/storage/.config/azahar/bin/azahar-wrapper
S=/storage/.config/azahar/bin/real/azahar-stock
grep -q " /usr/bin/azahar " /proc/mounts && exit 0
cmp -s /usr/bin/azahar $S || cp /usr/bin/azahar $S
[ -x "$B" ] && [ -x $S ] && mount --bind "$B" /usr/bin/azahar
exit 0
