#!/bin/bash
# Launches Azahar with the options set in EmulationStation (Advanced game options for 3DS, stored in
# system.cfg, per-game wins over global; added to the menu by install.sh). All off = original Azahar.
#   optimized_build=1    bin/real/azahar-rgds (-O3/LTO/PGO + patches); else bin/real/azahar-stock,
#                        the original /usr/bin/azahar copied there at boot by autostart/azahar-custom
#   frameskip=N          render 1 of every N+1 game frames (optimized build only)
#   frameskip_mode=top   only skip top-screen draws (safer); "all" skips every draw
# Neither binary runs as "azahar", so gptokeyb's killall -9 azahar misses it and azahar-gexit can
# close it cleanly (that is what saves the shader cache).
CFG=/storage/.config/system/configs/system.cfg
GAME="$(basename "${1}")"
opt() {
  local v
  v=$(grep -F "3ds[\"${GAME}\"].$1=" "$CFG" 2>/dev/null | tail -1 | cut -d= -f2)
  [ -z "$v" ] && v=$(grep "^3ds\.$1=" "$CFG" 2>/dev/null | tail -1 | cut -d= -f2)
  echo "$v"
}
R=/storage/.config/azahar/bin/real
BIN=$R/azahar-stock
if [ "$(opt optimized_build)" = 1 ] && [ -x $R/azahar-rgds ]; then
  BIN=$R/azahar-rgds
  FS=$(opt frameskip)
  [ -n "$FS" ] && [ "$FS" != 0 ] && export AZAHAR_FRAMESKIP="$FS" AZAHAR_FRAMESKIP_MODE="$(opt frameskip_mode)"
  # fps/speed once per second, for measuring over SSH
  export AZAHAR_FPS_LOG=/tmp/azahar-fps.log
fi
# Main window on the top panel. Runtime rule: /storage/.config/sway/config gets restored by ROCKNIXDS.
SWAYSOCK=${SWAYSOCK:-/var/run/0-runtime-dir/sway-ipc.0.sock} swaymsg \
  'for_window [app_id="org.azahar_emu.Azahar" title="^(?!.*Secondary).*$"] move window to output DSI-2' >/dev/null 2>&1
exec $BIN "$@"
