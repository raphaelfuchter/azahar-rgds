+    // Present-new-only hack (AZAHAR_PRESENT_NEW_ONLY=1, implied by frameskip): skip presenting
+    // when nothing new reached the screens, so frame generation layers (lsfg-vk) see only unique
+    // frames. Frame limiting and stats still run via EndFrame(). Forced present every 4 vblanks
+    // covers games that write the framebuffer directly from the CPU.
+    static const bool present_new_only = [] {
+        const char* env = std::getenv("AZAHAR_PRESENT_NEW_ONLY");
+        return frame_skip != 0 || (env && env[0] == '1');
+    }();
+    static u32 vblanks_since_present = 0;
+    if (present_new_only && !g_display_dirty && ++vblanks_since_present < 4) {
+        impl->renderer->EndFrame();
+    } else {
+        g_display_dirty = false;
+        vblanks_since_present = 0;
+        // Present renderered frame.
+        impl->renderer->SwapBuffers();
+    }
 
     // Reschedule recurrent event
     impl->timing.ScheduleEvent(FRAME_TICKS - cycles_late, impl->vblank_event);
