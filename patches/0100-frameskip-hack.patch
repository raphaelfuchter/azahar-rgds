+// Frameskip hack: framebuffers whose display transfer was dropped hold stale images.
+// Swapping to one of them would show an older frame, so such swaps are ignored.
+static std::vector<PAddr> g_stale_framebuffers;
+// Present-new-only hack: set when the displayed image may have changed since the last present.
+static bool g_display_dirty = true;
+
+// Frameskip hack (AZAHAR_FRAMESKIP=N): render 1 of every N+1 game frames.
+static u32 FrameSkip() {
+    static const u32 frame_skip = [] {
+        const char* env = std::getenv("AZAHAR_FRAMESKIP");
+        return env ? static_cast<u32>(std::strtoul(env, nullptr, 10)) : 0u;
+    }();
+    return frame_skip;
+}
+
+// Advanced on every top-screen buffer swap (the game's frame boundary), so 30fps games are
+// skipped per game frame rather than per vblank, which could split a frame in half.
+static void AdvanceFrameskip(Pica::PicaCore& pica) {
+    if (!FrameSkip()) {
+        return;
+    }
+    static const bool top_only = [] {
+        const char* env = std::getenv("AZAHAR_FRAMESKIP_MODE");
+        return env && std::string_view{env} == "top";
+    }();
+    static u32 frame_count = 0;
+    pica.skip_top_only = top_only;
+    pica.skip_draws = (++frame_count % (FrameSkip() + 1)) != 0;
+}
