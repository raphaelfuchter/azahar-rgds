 void GPU::VBlankCallback(std::uintptr_t user_data, s64 cycles_late) {
+    // Frameskip hack (AZAHAR_FRAMESKIP=N): render 1 of every N+1 frames.
+    static const u32 frame_skip = [] {
+        const char* env = std::getenv("AZAHAR_FRAMESKIP");
+        return env ? static_cast<u32>(std::strtoul(env, nullptr, 10)) : 0u;
+    }();
+    if (frame_skip) {
+        static u32 frame_count = 0;
+        impl->pica.skip_draws = (++frame_count % (frame_skip + 1)) != 0;
+    }
+
     // Signal to GSP that GPU interrupt has occurred
